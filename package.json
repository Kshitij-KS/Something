{
  "name": "callback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:app && npm run build:extension",
    "build:app": "vite build",
    "build:extension": "vite build --config extension/vite.config.ts",
    "stage:native-host": "cargo build --locked --release --package callback-native-host && node scripts/stage-native-host.mjs",
    "typecheck": "tsc --noEmit && tsc --project extension/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "evaluate:private-corpus": "cargo test --locked -p callback-app --test private_corpus -- --ignored --nocapture",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:extension": "node scripts/validate-extension.mjs",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "audit:local-only": "node scripts/audit-local-only.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  }
}
